GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=

# Blog repository settings
GITHUB_OWNER=otavio-dias-leite
GITHUB_REPO=blog
GITHUB_BRANCH=main
GITHUB_ALLOWED_LOGIN=otavio-dias-leite

